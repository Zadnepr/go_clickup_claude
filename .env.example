# Токен Claude Code, пробрасывается в процесс `claude`.
# Получить: claude setup-token (см. README.md).
CLAUDE_CODE_OAUTH_TOKEN=

# Personal API token ClickUp (pk_...).
CU_API_TOKEN=

# ID рабочего пространства ClickUp.
CU_TEAM_ID=

# ID списка (доски) с задачами на автоматическое ревью.
CU_LIST_ID=

# Секрет вебхука ClickUp. Выдаётся командой --register-webhook.
# Пусто -> эндпоинт /webhook/clickup не поднимается, сервис работает
# только на сверке (RECONCILE_INTERVAL).
CU_WEBHOOK_SECRET=

# Incoming Webhook URL канала Slack для уведомлений.
SLACK_WEBHOOK_URL=

# Путь к рабочей копии репозитория внутри контейнера.
REPO_PATH=/repo

# Если задан — сервис клонирует репозиторий при старте (нужен доступ по
# deploy key, см. docker-compose.yml). Если не задан — REPO_PATH монтируется
# томом с хоста.
REPO_URL=

# Тег-триггер. По умолчанию: ai
TRIGGER_TAG=

# Колонка-триггер. По умолчанию: to check
STATUS_TRIGGER=

# Колонка на время проверки. По умолчанию: checking
STATUS_RUNNING=

# Колонка при отсутствии критичных замечаний. Пусто -> переход не выполняется.
# Пример для доски "Core board": to check (возврат в очередь на финальный
# человеческий ревью, тег ai к этому моменту уже снят — повторно не сработает).
STATUS_PASS=

# Колонка при наличии критичных замечаний (или blocked). Пусто -> переход не выполняется.
# Пример для доски "Core board": rework
STATUS_FAIL=

# ID пользователя ClickUp, назначаемого при провале. Пусто -> назначается
# исполнитель, снятый на время проверки (или автор задачи, если исполнителей не было).
ASSIGNEE_ON_FAIL=

# ID пользователя ClickUp, назначаемого при успехе (финальный ревьюер-человек).
# Пусто -> исполнители не меняются. Пример: 81838079 (Andrey Zadneprianiy)
ASSIGNEE_ON_PASS=

# Количество параллельных воркеров. По умолчанию: 1
WORKER_CONCURRENCY=

# Таймаут одного прогона ревью (Go duration, например 15m). По умолчанию: 15m
REVIEW_TIMEOUT=

# Интервал сверки (Go duration, например 5m). 0 отключает сверку. По умолчанию: 5m
RECONCILE_INTERVAL=

# Пауза всей очереди при исчерпанном лимите использования claude (Go duration,
# например 30m) — задача возвращается в триггерный статус и подбирается
# заново сверкой автоматически, без ручного вмешательства. По умолчанию: 30m
USAGE_LIMIT_PAUSE=

# Порт HTTP-сервера. По умолчанию: 8080
PORT=

# Путь к файлу SQLite. По умолчанию: /data/state.db
DB_PATH=
